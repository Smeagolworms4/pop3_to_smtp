# --------------------------------------------------------------------------
# pop3-to-smtp — tout est facultatif.
#
# Le fichier peut rester vide : boîtes, destinations et réglages se
# configurent depuis l'interface web et sont enregistrés dans data/config.json.
#
# Une variable renseignée ici *verrouille* le réglage correspondant : le champ
# apparaît grisé dans l'interface, avec le nom de la variable responsable.
# Pratique pour figer une valeur, gênant quand c'est involontaire — d'où les
# lignes commentées ci-dessous.
# --------------------------------------------------------------------------

# Fuseau horaire, pour les dates affichées et journalisées.
TZ=Europe/Paris

# Identité du conteneur : doit correspondre au propriétaire de ./data.
# `id -u` et `id -g` sur l'hôte donnent les bonnes valeurs.
PUID=1000
PGID=1000

# Port côté hôte, si 8080 est déjà pris.
#WEB_PORT_HOST=8080

# --- Interface web --------------------------------------------------------

# Authentification. Laisser vide = accès libre (réseau local uniquement !).
# Dès qu'un des deux est renseigné, l'interface ET l'API sont protégées.
#WEB_USER=admin
#WEB_PASSWORD=change-moi

# --- Réglages par défaut --------------------------------------------------
# Décommenter fige le réglage : il ne sera plus modifiable dans l'interface.

# Délai entre deux relèves, en minutes. 0 = automatique désactivé.
#REFRESH_MINUTES=10

# Relever au démarrage du conteneur.
#RUN_ON_START=true

# Messages traités au maximum par boîte et par passage. Les suivants
# attendront le passage d'après : de quoi absorber une grosse boîte sans
# saturer le SMTP de destination.
#MAX_PER_RUN=50

# Taille maximale d'un message, en Mo. 0 = aucune limite.
# Gmail refuse au-delà de 25 Mo de toute façon.
#MAX_SIZE_MB=25

# Nombre d'actions gardées dans l'historique.
#HISTORY_MAX=200

# --- Réseau ---------------------------------------------------------------

# Délais d'attente, en millisecondes. À augmenter sur une liaison lente ou
# pour des boîtes contenant de très gros messages.
#POP3_TIMEOUT=60000
#SMTP_TIMEOUT=60000
#IMAP_TIMEOUT=60000

# --- Divers ---------------------------------------------------------------

# debug | info | warn | error
#LOG_LEVEL=info

# Emplacement des fichiers de configuration et d'état dans le conteneur.
#DATA_DIR=/data
